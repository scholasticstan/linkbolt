# Postgres connection string. Locally: postgres://localhost/linkbolt
DATABASE_URL=postgres://localhost/linkbolt
# Used to sign nothing yet but reserved for future use; sessions are DB-backed random tokens.
# Salt for daily visitor hashing. Any long random string.
VISITOR_SALT=change-me-to-a-long-random-string
# Public origin of the deployment, no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
